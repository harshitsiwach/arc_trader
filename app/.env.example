# Arc Mainnet RPC (defaults to https://rpc.mainnet.arc.io if unset)
VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
# P1 betting engine (node server/index.mjs)
VITE_BETTING_API_URL=http://localhost:8787
# P2 onchain betting (Arc Testnet)
VITE_VAULT_ADDR=0x92Bdf0aC7E33FF4D2ae6026c370b893dcd47Dc2c
VITE_ROUNDS_ADDR=0xCe10F9bed67F23814f5304931cB554beE3bcCD54
VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.io
# P3 staking (filled after Studio deploy)
VITE_STAKE_VAULT_ADDR=
VITE_REWARD_TOKEN_ADDR=
# ERC-4337 smart accounts (Circle Modular Wallets). Client Key from
# console.circle.com → Keys → Client Keys (TEST_API_KEY:…). Never commit real keys.
# Plus in Console: Passkey Domain = this app's domain; Gas Station paymaster policy.
VITE_CLIENT_KEY=
VITE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
