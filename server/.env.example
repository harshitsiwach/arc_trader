# Server engine env — copy to .env (never commit). Keys stay server-side only.
PORT=8787
DATA_PATH=./data.json
START_BANKROLL=10000
SETTLE_SECRET=change-me-to-random

# Fiat onramp widget (App Kit Onramp). Get the key at console.circle.com → API keys.
# Without these, /api/onramp/sessions answers 501 and the Fund tab shows setup steps.
CIRCLE_API_KEY=
REFERRER_DOMAIN=localhost
